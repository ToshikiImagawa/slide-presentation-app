      }
    },
    {
      "id": "layout-content-steps",
      "layout": "content",
      "meta": { "master": "gridNote" },
      "content": {
        "title": "layout: content (steps)",
        "steps": [
          { "number": 1, "title": "Step 1", "description": "steps render as a timeline" },
          { "number": 2, "title": "Step 2", "description": "Specify number / title / description" }
        ],
        "footer": "Specifying steps renders a timeline layout"
      }
    },
    {
      "id": "layout-content-tiles",
      "layout": "content",
      "content": {
        "title": "layout: content (tiles)",
