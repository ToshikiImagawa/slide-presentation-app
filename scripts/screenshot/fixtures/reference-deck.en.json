        "tiles": [
          { "icon": "Description", "title": "Tile 1", "description": "Specify icon / title / description" },
          { "icon": "Search", "title": "Tile 2", "description": "Icons are specified by MUI icon name" },
          { "icon": "Memory", "title": "Tile 3", "description": "tileColumns sets the column count" },
          { "icon": "PlaylistAddCheck", "title": "Tile 4", "description": "Wraps onto the next row past the column count" },
          { "icon": "Traffic", "title": "Tile 5", "description": "Stays readable with 6+ tiles" },
          { "icon": "FactCheck", "title": "Tile 6", "description": "Default column count equals tile count (1 row)" }
        ]
      }
    },
    {
