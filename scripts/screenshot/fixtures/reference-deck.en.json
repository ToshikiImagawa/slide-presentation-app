      "messageInverse": { "background": { "type": "fill", "color": "#f8fafc" }, "decorations": [] },
      "closing": {
        "background": { "type": "fill", "color": "#f8fafc" },
        "decorations": [
          {
            "type": "logo",
            "anchor": "bottom-center",
            "src": "data:image/svg+xml;base64,",
            "width": 300,
            "height": 125,
            "opacity": 0.9
          },
          { "type": "text", "anchor": "middle-right", "content": "SAMPLE", "fontSize": 32, "opacity": 0.16, "rotate": -18 }
        ]
      },
      "gridNote": { "background": { "type": "grid", "color": "#11182f", "size": 56 }, "decorations": [] },
      "sectionDivider": {
        "background": { "type": "gradient", "from": "#0f172a", "to": "#1e293b", "angle": 135 },
        "decorations": []
      },
      "chapterFooter": {
        "decorations": [
          { "type": "band", "anchor": "top-center", "thickness": 10, "offset": { "y": 6 }, "color": "#f59e0b" },
          { "type": "text", "anchor": "bottom-center", "content": "{index}/{total}", "fontSize": 16, "offset": { "y": -10 } },
          { "type": "text", "anchor": "bottom-left", "content": "{sectionTitle} {sectionIndex}/{sectionTotal}", "fontSize": 14 }
        ]
      },
      "photoBackdrop": {
        "background": {
          "type": "image",
          "src": "data:image/svg+xml;base64,",
          "fit": "cover"
        },
        "decorations": []
      }
    },
    "masterMap": { "center/message-inverse": "messageInverse", "center/closing": "closing", "center/section": "sectionDivider" },
    "tokens": {
      "gridNote": { "theme-background-grid": "#27314f" },
      "messageInverse": { "theme-text-body": "#0f172a", "theme-text-muted": "#475569" },
      "closing": { "theme-text-body": "#0f172a", "theme-text-muted": "#475569", "theme-primary": "#0f766e" },
      "sectionDivider": { "theme-text-body": "#f8fafc", "theme-text-muted": "#cbd5e1" },
      "photoBackdrop": { "theme-text-body": "#f8fafc", "theme-text-muted": "#e2e8f0" }
    }
  },
  "slides": [
    {
      "id": "layout-center",
