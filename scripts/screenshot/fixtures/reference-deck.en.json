          "heading": "Left column",
          "paragraphs": ["Place heading / paragraphs / items"],
          "items": [{ "text": "Bullet item 1" }, { "text": "Bullet item 2" }]
        },
        "right": {
          "codeBlock": {
            "header": "> right",
            "items": ["{", "  \"left\": {},", "  \"right\": {}", "}"]
          },
          "accentText": "Place codeBlock / accentText, etc."
        }
      }
    },
    {
      "id": "layout-bleed",
