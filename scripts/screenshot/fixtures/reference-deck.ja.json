        "decorations": [
          { "type": "band", "anchor": "top-center", "thickness": 10, "offset": { "y": 6 }, "color": "#f59e0b" },
          { "type": "text", "anchor": "bottom-center", "content": "{index}/{total}", "fontSize": 16, "offset": { "y": -10 } },
          { "type": "text", "anchor": "bottom-left", "content": "{sectionTitle} {sectionIndex}/{sectionTotal}", "fontSize": 14 }
        ]
      },
