{
  "meta": {
    "title": "Reference Deck",
    "description": "全スライド種別を1枚ずつ並べた開発・検証用の基準見本デッキ（配布サンプルとは別。テーマ差し替えの回帰検知に使う）"
  },
  "theme": {
    "masters": {
      "messageInverse": { "background": { "type": "fill", "color": "#f8fafc" }, "decorations": [] },
      "closing": {
        "background": { "type": "fill", "color": "#f8fafc" },
        "decorations": [
          {
            "type": "logo",
            "anchor": "bottom-center",
            "src": "data:image/svg+xml;base64,",
            "width": 300,
            "height": 125,
            "opacity": 0.9
          }
        ]
      }
    },
    "masterMap": { "center/message-inverse": "messageInverse", "center/closing": "closing" },
    "tokens": {
      "messageInverse": { "theme-text-body": "#0f172a", "theme-text-muted": "#475569" },
      "closing": { "theme-text-body": "#0f172a", "theme-text-muted": "#475569", "theme-primary": "#0f766e" }
    }
  },
  "slides": [
    {
      "id": "layout-center",
      "layout": "center",
      "content": {
        "title": "layout: center",
        "subtitle": "タイトルスライド。title と任意の subtitle を表示"
      }
    },
    {
      "id": "layout-center-section",
      "layout": "center",
      "content": {
        "variant": "section",
        "title": "layout: center (variant: section)",
        "body": "章の区切りやまとめに使う大きな本文。\n複数行の body に対応"
      }
    },
    {
      "id": "layout-content-steps",
      "layout": "content",
      "content": {
        "title": "layout: content (steps)",
        "steps": [
          { "number": 1, "title": "手順1", "description": "steps はタイムライン形式で描画" },
          { "number": 2, "title": "手順2", "description": "number / title / description を指定" }
        ],
        "footer": "steps を指定するとタイムライン形式で表示されます"
      }
    },
    {
      "id": "layout-content-tiles",
      "layout": "content",
      "content": {
        "title": "layout: content (tiles)",
        "tileColumns": 3,
        "tiles": [
          { "icon": "Description", "title": "タイル1", "description": "icon / title / description を指定" },
          { "icon": "Search", "title": "タイル2", "description": "アイコンは MUI アイコン名で指定" },
          { "icon": "Memory", "title": "タイル3", "description": "tileColumns で列数を指定" },
          { "icon": "PlaylistAddCheck", "title": "タイル4", "description": "列数を超えると次の行へ折返す" },
          { "icon": "Traffic", "title": "タイル5", "description": "6枚以上でも読める大きさを保つ" },
          { "icon": "FactCheck", "title": "タイル6", "description": "既定は列数=タイル数（1行）" }
        ]
      }
    },
    {
      "id": "layout-content-component",
      "layout": "content",
      "content": {
        "title": "layout: content (component)",
        "component": {
          "name": "TerminalAnimation",
          "props": { "title": "component", "logText": "$ layout: content\n> component を埋め込み\n✓ done" },
          "style": { "height": "360px", "width": "80%", "margin": "auto" }
        }
      }
    },
    {
      "id": "layout-two-column",
      "layout": "two-column",
      "content": {
        "title": "layout: two-column",
        "left": {
          "heading": "左カラム",
          "paragraphs": ["heading / paragraphs / items を配置"],
          "items": [{ "text": "箇条書き項目1" }, { "text": "箇条書き項目2" }]
        },
        "right": {
          "codeBlock": {
            "header": "> right",
            "items": ["{", "  \"left\": {},", "  \"right\": {}", "}"]
          },
          "accentText": "codeBlock / accentText などを配置"
        }
      }
    },
    {
      "id": "layout-bleed",
      "layout": "bleed",
      "content": {
        "title": "layout: bleed",
        "titleDescription": "左にタイトルとコマンド、右に任意のコンポーネント",
        "commands": [
          { "text": "$ command-1", "color": "var(--theme-text-heading)" },
          { "text": "> command-2", "color": "var(--theme-primary)" }
        ],
        "component": {
          "name": "TerminalAnimation",
          "props": { "title": "bleed", "logText": "$ layout: bleed\n> 2カラム全幅\n✓ done" },
          "style": { "height": "360px", "width": "90%", "margin": "auto" }
        }
      }
    },
    {
      "id": "layout-custom",
      "layout": "custom",
      "content": {
        "component": {
          "name": "TerminalAnimation",
          "props": { "title": "layout: custom", "logText": "$ layout: custom\n> ラッパー無しで全画面描画\n✓ done" },
          "style": { "height": "70%", "width": "80%", "margin": "auto" }
        }
      }
    },
    {
      "id": "layout-content-body-items",
      "layout": "content",
      "content": {
        "title": "layout: content (body/items)",
        "body": "steps / tiles / component をいずれも指定しない場合、body と items でプレーンな本文を描画します。",
        "items": [
          { "text": "body: 複数行に対応した段落テキスト", "emphasis": true },
          {
            "text": "items: 箇条書き（ネスト可）",
            "items": [{ "text": "子要素にもさらに items を指定できる" }, { "text": "emphasis: true で太字強調", "emphasis": true }]
          }
        ]
      }
    },
    {
      "id": "layout-content-images",
      "layout": "content",
      "content": {
        "title": "layout: content (images)",
        "images": [
          {
            "src": "data:image/svg+xml;base64,",
            "alt": "横長のサンプル画像",
            "caption": "横長（16:9）"
          },
          {
            "src": "data:image/svg+xml;base64,",
            "alt": "縦長のサンプル画像",
            "caption": "縦長（3:4）"
          },
          {
            "src": "data:image/svg+xml;base64,",
            "alt": "正方形のサンプル画像",
            "caption": "正方形（1:1）"
          }
        ]
      }
    },
    {
      "id": "layout-content-diagram",
      "layout": "content",
      "content": {
        "title": "図解プリミティブ（Diagram）",
        "component": {
          "name": "Diagram",
          "props": {
            "nodes": [
              { "id": "a", "rect": { "x": 0.02, "y": 0.06, "w": 0.16, "h": 0.26 }, "title": "カード", "body": "outline", "badge": 1, "color": "primary" },
              { "id": "b", "rect": { "x": 0.3, "y": 0.06, "w": 0.16, "h": 0.26 }, "title": "カード", "body": "filled", "badge": 2, "color": "success", "variant": "filled" },
              { "id": "c", "rect": { "x": 0.02, "y": 0.64, "w": 0.16, "h": 0.26 }, "title": "カード", "body": "plain", "badge": 3, "color": "neutral", "variant": "plain" }
            ],
            "connectors": [
              { "from": "a", "to": "b", "head": "triangle", "label": "コネクタ" },
              { "from": "b", "to": "c", "routing": "vertical", "head": "triangle" }
            ],
            "arrows": [
              { "from": { "x": 0.53, "y": 0.1 }, "to": { "x": 0.97, "y": 0.1 }, "head": "arrow", "label": "矢印（水平）" },
              { "from": { "x": 0.53, "y": 0.28 }, "to": { "x": 0.97, "y": 0.44 }, "head": "triangle", "thickness": 3, "label": "斜め" },
              { "from": { "x": 0.56, "y": 0.55 }, "to": { "x": 0.56, "y": 0.8 }, "head": "arrow" },
              { "from": { "x": 0.64, "y": 0.55 }, "to": { "x": 0.64, "y": 0.8 }, "head": "triangle", "tail": "dot", "dashed": true }
            ],
            "badges": [{ "at": { "x": 0.9, "y": 0.6 }, "text": "★", "shape": "square", "color": "warning" }],
            "callouts": [{ "at": { "x": 0.876, "y": 0.638 }, "to": { "x": 0.8, "y": 0.86 }, "label": "引出線" }]
          }
        }
      }
    },
