{
  "_comment": "slides.json のレイアウト別 content 構造の単一ソース。AI生成プロンプト（src-tauri/src/generation/mod.rs の system_prompt）と生成専用の厳格チェック（src/data/slideContentSchema.ts）の両方がこのファイルを参照する。人間向けの詳細例は .claude/skills/create-slides/LAYOUT_REFERENCE.md を参照（このファイルと同期させること）。",
  "layouts": {
    "center": {
      "description": "タイトル・まとめ用の中央寄せレイアウト。variant: \"section\" を指定すると SectionLayout に切り替わる",
      "contentFields": {
        "title": { "type": "string" },
        "subtitle": { "type": "string", "description": "サブタイトル（改行は \\n）" },
        "variant": { "type": "string", "enum": ["section"] },
        "body": { "type": "string", "description": "variant=section 時の本文（改行は \\n）" },
        "qrCode": { "type": "string", "description": "variant=section 時のQRコード対象URL" },
        "githubRepo": { "type": "string", "description": "variant=section 時の owner/repo 表記" }
      }
    },
    "content": {
      "description": "コンテンツ表示用レイアウト。子要素のフィールドで描画が決まる（steps→Timeline / tiles→FeatureTileGrid / component→カスタム）",
      "contentFields": {
        "title": { "type": "string" },
        "steps": {
          "type": "array",
          "description": "Timelineの各ステップ",
          "itemFields": {
            "number": { "type": "number" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "command": { "type": "string" }
          }
        },
        "tiles": {
          "type": "array",
          "description": "FeatureTileGridのタイル",
          "itemFields": {
            "icon": { "type": "string", "enum": ["Description", "PlaylistAddCheck", "Traffic", "FactCheck", "Memory", "Search"] },
            "title": { "type": "string" },
            "description": { "type": "string", "description": "<br/>等HTMLタグ利用可" }
          }
        },
        "component": { "type": "object", "ref": "componentReference" },
        "footer": { "type": "string" }
      }
    },
    "two-column": {
      "description": "左右2カラムレイアウト。left/rightは columnContentFields を組み合わせて構成する",
      "contentFields": {
        "title": { "type": "string" },
        "left": { "type": "object", "ref": "columnContentFields" },
        "right": { "type": "object", "ref": "columnContentFields" }
      }
    },
    "bleed": {
      "description": "2カラム全幅レイアウト。左にテキスト、右にコンポーネント",
      "contentFields": {
        "title": { "type": "string" },
        "titleDescription": { "type": "string" },
        "commands": {
          "type": "array",
          "itemFields": {
            "text": { "type": "string" },
            "color": { "type": "string", "description": "例: var(--theme-primary)" }
          }
        },
        "component": { "type": "object", "ref": "componentReference" }
      }
    },
    "custom": {
      "description": "カスタムコンポーネントを直接描画",
      "contentFields": {
        "component": { "type": "object", "ref": "componentReference" }
      }
    }
  },
  "columnContentFields": {
    "description": "two-columnの left/right に指定可能なフィールド（すべてオプション、組み合わせ可）。componentを指定した場合は他のフィールドは無視される",
    "heading": { "type": "string" },
    "headingDescription": { "type": "string" },
    "paragraphs": { "type": "array", "description": "段落テキストの配列（HTMLタグ可）" },
    "items": {
      "type": "array",
      "itemFields": {
        "text": { "type": "string" },
        "emphasis": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "codeBlock": {
      "type": "object",
      "fields": {
        "header": { "type": "string" },
        "items": { "type": "array", "description": "行文字列の配列" }
      }
    },
    "titledBulletList": {
      "type": "object",
      "fields": {
        "title": { "type": "string" },
        "items": { "type": "array", "description": "項目文字列の配列" }
      }
    },
    "accentText": { "type": "string" },
    "component": { "type": "object", "ref": "componentReference" }
  },
  "componentReference": {
    "description": "content.component / left.component 等で参照するカスタムコンポーネント",
    "name": { "type": "string" },
    "props": { "type": "object" },
    "style": { "type": "object" }
  },
  "builtinComponents": ["TerminalAnimation", "Image"],
  "builtinIcons": ["Description", "PlaylistAddCheck", "Traffic", "FactCheck", "Memory", "Search"],
  "presentationMeta": {
    "description": "トップレベル meta（プレゼン全体の設定）",
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "logo": {
      "type": "object",
      "fields": {
        "src": { "type": "string" },
        "width": { "type": "number", "description": "デフォルト120" },
        "height": { "type": "number", "description": "デフォルト40" }
      }
    },
    "themeColors": { "type": "string" },
    "brandTheme": { "type": "string", "description": "組織/ブランドテーマ（外部 ThemeData JSON への参照パス）。reset→brandTheme→themeColors→theme の順で下地として適用される" }
  },
  "slideMeta": {
    "description": "各スライド共通のmeta（オプション）",
    "transition": { "type": "string" },
    "backgroundColor": { "type": "string" },
    "backgroundImage": { "type": "string", "description": "例: url(/bg.png)" },
    "notes": {
      "type": ["string", "object"],
      "description": "文字列、またはSlideNotesオブジェクト",
      "fields": {
        "speakerNotes": { "type": "string" },
        "summary": { "type": "array", "description": "要点文字列の配列" },
        "voice": { "type": "string", "description": "音声ファイルへの相対パス" }
      }
    },
    "master": { "type": "string", "description": "このスライドに直接適用するmasterKey（theme.mastersのキー）。theme.masterMapによる解決より優先する" }
  },
  "theme": {
    "description": "プレゼン全体のtheme（トップレベル、オプション）",
    "colors": {
      "type": "object",
      "description": "primary/accent/background/backgroundAlt/backgroundGrid/text/textHeading/textBody/textSubtitle/textMuted/border/borderLight/codeText/success。primaryとaccentは別の色として反映される"
    },
    "fonts": {
      "type": "object",
      "fields": {
        "heading": { "type": "string" },
        "body": { "type": "string" },
        "code": { "type": "string" },
        "baseFontSize": { "type": "number", "description": "デフォルト20px" },
        "sources": {
          "type": "array",
          "itemFields": {
            "family": { "type": "string" },
            "src": { "type": "string", "description": "ローカルフォントファイルパス" },
            "url": { "type": "string", "description": "外部フォントURL" },
            "weight": { "type": "string", "description": "font-weight（例: '400','700','normal','bold'）。省略時は'normal'" },
            "style": { "type": "string", "description": "font-style（例: 'normal','italic'）。省略時は'normal'" },
            "format": { "type": "string", "description": "src指定時のフォント形式ヒント（例: 'woff2'）" },
            "localName": { "type": "string", "description": "ローカルインストール済みフォント名（local()参照）" }
          }
        }
      }
    },
    "customCSS": { "type": "string" },
    "masters": {
      "type": "object",
      "description": "masterKey → マスター定義。帯・ロゴ・フッター・ページ番号等の装飾セットを宣言する（キーは任意の文字列）",
      "itemFields": {
        "extends": { "type": "string", "description": "継承元のmasterKey。循環参照は不可" },
        "decorations": {
          "type": "array",
          "description": "logo/band/rule/text/image/component の6種のみ許可（DSL膨張の歯止め）",
          "itemFields": {
            "type": { "type": "string", "enum": ["logo", "band", "rule", "text", "image", "component"] },
            "anchor": {
              "type": "string",
              "enum": ["top-left", "top-center", "top-right", "middle-left", "middle-center", "middle-right", "bottom-left", "bottom-center", "bottom-right"],
              "description": "9方向のアンカー位置"
            },
            "offset": { "type": "object", "description": "{ x, y } でアンカーからのpxオフセット" },
            "only": { "type": "string", "enum": ["first", "last", "not-first", "all"], "description": "省略時は all" },
            "layer": { "type": "string", "enum": ["back", "front"], "description": "省略時は back" },
            "src": { "type": "string", "description": "type: logo/image で使用する画像パス" },
            "width": { "type": "number", "description": "type: logo/image で使用" },
            "height": { "type": "number", "description": "type: logo/image で使用" },
            "color": { "type": "string", "description": "type: band/rule/text で使用" },
            "thickness": { "type": "number", "description": "type: band/rule で使用（帯・線の太さ）" },
            "length": { "type": "number", "description": "type: rule で使用（線の長さ）" },
            "orientation": { "type": "string", "enum": ["horizontal", "vertical"], "description": "type: band/rule で使用" },
            "content": { "type": "string", "description": "type: text で使用。{index}/{total}でページ番号を展開" },
            "fontSize": { "type": "number", "description": "type: text で使用" },
            "name": { "type": "string", "description": "type: component で使用。ComponentRegistryに登録済みのコンポーネント名" },
            "props": { "type": "object", "description": "type: component で使用" }
          }
        }
      }
    },
    "masterMap": {
      "type": "object",
      "description": "キーは\"<layout>\"（center/content/two-column/bleed/custom）または\"<layout>/<variant>\"（例: center/section）→ masterKey の対応表。解決順序はslide.meta.master→masterMap[\"layout/variant\"]→masterMap[\"layout\"]→装飾なし。未指定のレイアウトには装飾を描画しない"
    },
    "tokens": {
      "type": "object",
      "description": "masterKey → { CSS変数名: 値 } 。section[data-master=\"masterKey\"] スコープのCSS変数として出力される"
    }
  }
}
