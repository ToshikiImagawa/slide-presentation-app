{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Slide Presentation App",
  "version": "2.2.0",
  "identifier": "com.toshikiimagawa.slide-presentation-app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slide Presentation App",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["spkg"],
        "name": "Slide Package",
        "description": "Slide Presentation Package",
        "mimeType": "application/x-slide-package",
        "role": "Editor",
        "exportedType": {
          "identifier": "com.toshikiimagawa.slide-presentation-app.spkg",
          "conformsTo": ["public.data", "public.archive"]
        }
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/slide-presentation-app.xml": "linux/slide-package-mime.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/slide-presentation-app.xml": "linux/slide-package-mime.xml"
        }
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0Q0M1ODUzQzQ1RjBCNTMKUldSVEMxL0VVMWpNMUNFdjlSSHBIWHkwR08wSzEvWUxVdjMrNkhmL0o0QjEyVVFERzBLTWYxdjUK",
      "endpoints": [
        "https://github.com/ToshikiImagawa/slide-presentation-app/releases/latest/download/latest.json"
      ]
    }
  }
}
